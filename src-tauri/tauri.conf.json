{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "warp-clone",
  "version": "0.1.0",
  "identifier": "com.sthevandev.warpclone",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "warp-clone",
        "width": 1000,
        "height": 640,
        "minWidth": 480,
        "minHeight": 320,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
