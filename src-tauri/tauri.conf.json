{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn",
  "version": "0.2.0",
  "identifier": "com.sthevandev.cairn",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cairn",
        "width": 1000,
        "height": 640,
        "minWidth": 480,
        "minHeight": 320,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxNzc0NjIwQzIxMzUzNjUKUldSbFV4UENJRVozd1FZTnJsODQxWVd5NWlDZlQ0bTFwT2dlOW96TlNhejdPS0svWXpXdlVRaWEK",
      "endpoints": ["https://github.com/sthevan027/cairn/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "certificateThumbprint": "90B3F30DA2F905C7CA0EFE7485E4E026FBA74D78",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
